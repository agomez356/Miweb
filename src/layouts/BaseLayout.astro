---
import '../assets/styles/global.css';
import Header from '../components/common/Header.vue';
import Footer from '../components/common/Footer.vue';
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Path used to mark the current section. The 404 page passes "" so no link is current. */
  currentPath?: string;
}

const {
  title,
  description = 'Blog educativo de física moderna',
  ogImage,
  currentPath = Astro.url.pathname,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} sizes="180x180" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <title>{title} — FísicaFans</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- KaTeX CSS — must be in <head>, NOT in global.css -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4RtvSljdZF8WRiHE+c9Y/fvJr/GVGnGQFYwJJ7cWz0sHqerS"
      crossorigin="anonymous"
    />

    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:title" content={`${title} | FísicaFans`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Header client:load currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer client:load currentPath={currentPath} />
  </body>
</html>
