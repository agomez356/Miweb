---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/blog/TableOfContents.vue';
import ReadingProgress from '../components/blog/ReadingProgress.vue';
import { siteAuthor } from '../data/author';
import { readingLevelLabels } from '../types/index';
import { formatDate } from '../utils/formatDate';
import { formatReadingTime, readingTimeMinutes } from '../utils/readingTime';
import { withBase } from '../utils/withBase';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const { title, description, category, pubDate, level } = entry.data;
const readingLabel = formatReadingTime(readingTimeMinutes(entry.body));
const acercaHref = withBase('/acerca/');
const published = pubDate.toISOString().slice(0, 10);

const categoryLabels: Record<string, string> = {
  'termodinamica': 'Termodinámica',
  'mecanica-cuantica': 'Mecánica Cuántica',
  'fisica-clasica': 'Física Clásica',
  'electromagnetismo': 'Electromagnetismo',
  'relatividad': 'Relatividad',
};
---

<BaseLayout title={title} description={description}>
  <ReadingProgress client:load />

  <div class="max-w-6xl mx-auto px-4 pt-32 pb-24">
    <div class="lg:grid lg:grid-cols-[1fr_220px] lg:gap-12">
      <!-- Article content -->
      <article>
        <!-- Header -->
        <header class="mb-12">
          <p class="font-space text-sm mb-4 flex flex-wrap items-center gap-x-2 gap-y-1">
            <span class="text-tertiary uppercase tracking-widest">{categoryLabels[category]}</span>
            <span class="text-text-muted" aria-hidden="true">·</span>
            <span class="font-body text-text-secondary">{readingLevelLabels[level]}</span>
          </p>
          <h1 class="font-space font-bold text-4xl md:text-5xl text-text-primary leading-tight mb-4">
            {title}
          </h1>
          <p class="font-body text-text-muted text-sm mb-6 flex flex-wrap items-center gap-x-3 gap-y-1">
            <a href={acercaHref} class="inline-flex items-center min-h-11 text-primary hover:text-primary-light transition-colors">
              {siteAuthor.name}
            </a>
            <span aria-hidden="true">·</span>
            <time datetime={published}>{formatDate(pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{readingLabel}</span>
          </p>
          <p class="font-body text-text-secondary text-lg">{description}</p>
        </header>

        <!-- MDX content -->
        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:font-space prose-headings:font-semibold prose-headings:text-text-primary
          prose-p:font-body prose-p:text-text-secondary prose-p:leading-relaxed
          prose-a:text-primary prose-a:no-underline hover:prose-a:text-primary-light
          prose-code:text-primary-light prose-code:bg-surface prose-code:px-1 prose-code:rounded
          prose-pre:bg-surface prose-pre:border prose-pre:border-primary/15
          prose-strong:text-text-primary
          prose-blockquote:border-primary/40 prose-blockquote:text-text-secondary">
          <slot />
        </div>
      </article>

      <!-- Sticky ToC -->
      <aside>
        <TableOfContents client:load headings={headings} />
      </aside>
    </div>
  </div>
</BaseLayout>
