---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/blog/Breadcrumbs.astro';
import PostCard from '../../../components/blog/PostCard.vue';
import { CATEGORIES } from '../../../utils/categories';
import { withBase } from '../../../utils/url';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.id },
  }));
}

const categoryId = Astro.params.category;
const category = CATEGORIES.find((item) => item.id === categoryId);
if (!category) {
  throw new Error(`Categoría no válida: ${String(categoryId)}`);
}

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === category.id)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const countLabel = posts.length === 1 ? 'Un artículo en esta rama.' : `${posts.length} artículos en esta rama.`;
---

<BaseLayout title={category.title} description={category.description}>
  <div class="max-w-6xl mx-auto px-4 pt-32 pb-24">
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: withBase() },
        { label: 'Blog', href: withBase('blog/') },
        { label: category.title },
      ]}
    />
    <p class="font-space text-tertiary text-sm uppercase tracking-widest mb-3">Blog</p>
    <h1 class="font-space font-bold text-4xl md:text-5xl text-text-primary mb-4">{category.title}</h1>
    <p class="font-body text-lg text-text-secondary max-w-3xl mb-3">{category.description}</p>

    {
      posts.length === 0 ? (
        <div class="py-16">
          <p class="mb-6 font-body text-text-muted">Todavía no hay artículos en esta rama.</p>
          <a
            href={withBase('blog/')}
            class="inline-flex min-h-11 items-center font-space text-primary transition-colors hover:text-primary-light focus-visible:rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
          >
            Volver al blog
          </a>
        </div>
      ) : (
        <>
          <p class="mb-12 font-body text-sm text-text-muted">{countLabel}</p>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <PostCard
                client:visible
                title={post.data.title}
                description={post.data.description}
                category={post.data.category}
                pubDate={post.data.pubDate}
                slug={post.slug}
              />
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>
