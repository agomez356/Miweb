---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';

const home = withBase();
const blog = withBase('blog/');
---

<BaseLayout
  title="Página no encontrada"
  description="La dirección no corresponde a ninguna página de FísicaFans."
  currentPath=""
>
  <section class="max-w-3xl mx-auto px-4 pt-32 pb-16 text-center">
    <p class="font-space text-tertiary text-sm uppercase tracking-widest mb-3">Error 404</p>
    <h1 class="font-space font-bold text-4xl md:text-5xl text-text-primary mb-6">
      Esta página no existe
    </h1>
    <p class="font-body text-text-secondary text-lg leading-relaxed mb-10">
      No encontramos nada en esta dirección. Puedes volver al inicio o seguir leyendo en el blog.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={home}
        class="px-8 py-4 bg-gradient-to-r from-primary to-secondary text-space-bg font-space font-semibold rounded-celestial-xl hover:opacity-90 transition-opacity"
      >
        Ir al inicio
      </a>
      <a
        href={blog}
        class="px-8 py-4 glass font-space font-semibold text-text-primary rounded-celestial-xl hover:bg-primary/10 transition-colors"
      >
        Ir al blog
      </a>
    </div>
  </section>
</BaseLayout>
